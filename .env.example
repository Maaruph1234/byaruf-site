# AI assistant (required for live AI answers; without it the assistant answers from site content only)
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5
ANTHROPIC_MODEL=

# Enquiry email delivery through Resend (required for the forms to send email)
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "ByAruf Website <website@byaruf.xyz>"
ENQUIRY_FROM_EMAIL=
# Optional. Where enquiries go. Defaults to bookings@byaruf.xyz
ENQUIRY_TO_EMAIL=

# Optional: shared rate limiting across serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile spam protection on forms (set both)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
